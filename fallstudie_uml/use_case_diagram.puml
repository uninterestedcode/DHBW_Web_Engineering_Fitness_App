@startuml
left to right direction
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam rectangle {
    BackgroundColor<<subsystem>> #F0F8FF
    BorderColor<<subsystem>> #4682B4
}

title DHBW Fitness Web App - Use Case Diagram

actor "DHBW Student" as Student #LightBlue
actor "Unregistered Visitor" as Visitor #LightGray
actor "System Administrator" as Admin #LightCoral

rectangle "Authentication and Identity" <<subsystem>> {
    usecase "UC1: Register Account\nwith DHBW credentials" as UC1
    usecase "UC2: Log In" as UC2
    usecase "UC13: Edit Profile\nand Password" as UC13
    usecase "UC14: Reset Password\nvia Email" as UC14
    usecase "UC17: Delete Account\nand All Data" as UC17
}

rectangle "Running Data Management" <<subsystem>> {
    usecase "UC3: Upload CSV\nfrom Running Apps" as UC3
    usecase "UC15: Delete or Edit\na Running Record" as UC15
    usecase "UC16: Export Personal\nData as CSV" as UC16
}

rectangle "Personal Analytics" <<subsystem>> {
    usecase "UC4: View Weekly and\nMonthly Statistics" as UC4
    usecase "UC5: View Performance\nCharts and Trends" as UC5
    usecase "UC6: View Benchmark\nAgainst DHBW Average" as UC6
}

rectangle "Social Comparison" <<subsystem>> {
    usecase "UC7: View Individual\nLeaderboard" as UC7
    usecase "UC8: View Course-Level\nAggregated Stats" as UC8
    usecase "UC9: View Studiengang-Level\nComparison" as UC9
}

rectangle "AI Motivation Coach" <<subsystem>> {
    usecase "UC10: Receive Personalized\nMotivational Message" as UC10
    usecase "UC11: Receive Coaching\nSuggestion on Inactivity" as UC11
    usecase "UC12: View Milestone\nCelebration Insight" as UC12
}

rectangle "Legal and Public Pages" <<subsystem>> {
    usecase "UC19: View Impressum" as UC19
    usecase "UC20: View Datenschutz" as UC20
    usecase "UC21: View AGB" as UC21
    usecase "UC22: Accept or Decline\nCookie Consent" as UC22
    usecase "UC23: View Public\nLanding Page" as UC23
}

rectangle "System Administration" <<subsystem>> {
    usecase "UC24: Monitor Application\nHealth and Uptime" as UC24
    usecase "UC25: View Application\nLogs and Errors" as UC25
    usecase "UC26: Manage Database\nBackups" as UC26
    usecase "UC27: Deploy New\nApplication Version" as UC27
}

' DHBW Student connections
Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Student --> UC7
Student --> UC8
Student --> UC9
Student --> UC10
Student --> UC11
Student --> UC12
Student --> UC13
Student --> UC14
Student --> UC15
Student --> UC16
Student --> UC17

' Unregistered Visitor connections
Visitor --> UC19
Visitor --> UC20
Visitor --> UC21
Visitor --> UC22
Visitor --> UC23
Visitor --> UC7

' System Administrator connections
Admin --> UC24
Admin --> UC25
Admin --> UC26
Admin --> UC27

' Include relationships
UC3 ..> UC10 : <<include>>

' Extend relationships
UC11 ..> UC2 : <<extend>>
UC12 ..> UC4 : <<extend>>
UC14 ..> UC2 : <<extend>>

' Notes
note bottom of Student
  Authenticated with DHBW email,
  Matrikelnummer, and Kurscode.
  Can access all app features.
end note

note bottom of Visitor
  Can access legal pages,
  landing page, cookie banner,
  and a read-only leaderboard view.
end note

note bottom of Admin
  Team members who monitor
  system health, manage backups,
  and deploy updates.
end note

note right of UC3
  Supports CSV exports from
  Strava, Google Fit, and
  Apple Health.
end note

note right of UC7
  Ranked by total distance,
  average pace, or number
  of runs. Filterable by
  time period.
end note

@enduml